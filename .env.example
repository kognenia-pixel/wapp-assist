# Wapp Assist — valeurs à fournir (JAMAIS de vraies clés ici, ce fichier est livré).
# Les secrets vont dans Cloudflare via setup.sh (wrangler secret put), pas dans ce fichier.
#
# Côté acheteur : copiez ce fichier en .env local si besoin, remplissez, ne le partagez jamais.

# Worker
BRAIN_ADMIN_URL=https://wapp-assist-worker.VOTRE-COMPTE.workers.dev
ADMIN_SECRET=

# Meta (Meta Developer > votre app > WhatsApp > API Setup)
WHATSAPP_TOKEN=
VERIFY_TOKEN=
PHONE_NUMBER_ID=

# Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Marque blanche (affichée à vos clients)
BRAND_NAME=Ma Boutique
BRAND_COLOR=#12A66B
BRAND_WHATSAPP_NUMBER=+224 6XX XX XX XX
BRAND_LOGO_URL=
