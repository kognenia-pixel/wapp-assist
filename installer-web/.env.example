PORT=3001
INSTALLER_SECRET=change-me-tres-long-et-aleatoire
# URL publique du setup.sh
SETUP_SH_URL=https://raw.githubusercontent.com/ton-compte/wapp-assist/main/setup.sh
FRONTEND_ORIGIN=*
# --- Connexion WhatsApp en 1 clic (Meta Embedded Signup) ---
# Laisse vide pour mode simulation (le bouton “Connecter avec Meta” simule une connexion)
META_PROVIDER=direct
META_CLIENT_ID=
META_CLIENT_SECRET=
META_REDIRECT_URI=http://localhost:3001/auth/meta/callback
META_SCOPE=whatsapp_business_management,whatsapp_business_messaging,business_management,public_profile
# Fournisseur alternatif (360Dialog, ChatMitra, Ominiflow) : URL d’auth/token si différent
# META_AUTH_URL=https://hub.360dialog.io/api/v2/auth
# META_TOKEN_URL=https://hub.360dialog.io/api/v2/token
